---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../utils/posts';
import { withBase } from '../utils/url';

interface ShowcaseApp {
  id: string;
  name: string;
  enName?: string;
  genre: string;
  tagline: string;
  description: string;
  badges: string[];
  playUrl: string;
  extraUrl?: { label: string; href: string };
  iconUrl: string;
  thumbUrl: string;
}

const APPS: ShowcaseApp[] = [
  {
    id: 'cable-fix',
    name: 'Cable Fix',
    enName: '선 정리 퍼즐',
    genre: '오프라인 퍼즐',
    tagline: '빈자리 하나로, 엉킨 선을 차근차근.',
    description:
      '멀티탭의 빈 연결구를 활용해 플러그를 옮기고 엉킨 선을 정리해 기기에 전원을 켜는 차분한 두뇌 퍼즐입니다. 매번 새로 생성되는 보드와 큰 글자·오프라인 플레이를 지원합니다.',
    badges: ['오프라인 지원', '시간 제한 없음', '무료 되돌리기', '한/영/일 지원'],
    playUrl: 'https://play.google.com/store/apps/details?id=com.jrhapps.cablefix&hl=ko',
    extraUrl: { label: '게임 상세 소개', href: 'https://jrh-apps-site.vercel.app/cable-fix' },
    iconUrl: 'https://jrh-apps-site.vercel.app/assets/cable-fix-icon.webp',
    thumbUrl: 'https://jrh-apps-site.vercel.app/assets/cable-fix-play-ko-thumb.webp',
  },
  {
    id: 'bloom-sort',
    name: '꽃담',
    enName: 'Bloom Sort',
    genre: '힐링 꽃 정렬 퍼즐',
    tagline: '같은 꽃 네 송이, 한 다발로.',
    description:
      '알록달록한 꽃을 같은 종류 네 송이씩 모아 예쁜 꽃다발을 완성하는 힐링 정렬 퍼즐입니다. 무료 힌트와 무제한 되돌리기, 자동 저장 덕분에 언제든 부담 없이 즐길 수 있습니다.',
    badges: ['무료 힌트', '무제한 되돌리기', '자동 저장', '힐링 퍼즐'],
    playUrl: 'https://play.google.com/store/apps/details?id=com.jrhapps.bloomsort&hl=ko',
    iconUrl: 'https://jrh-apps-site.vercel.app/assets/bloom-sort-icon.webp',
    thumbUrl: 'https://jrh-apps-site.vercel.app/assets/bloom-sort-play-ko-thumb.webp',
  },
  {
    id: 'link-trail',
    name: 'Link Trail',
    enName: '그림 길 찾기 퍼즐',
    genre: '길 찾기 퍼즐',
    tagline: '겹치지 않게, 모든 그림을 잇기.',
    description:
      '같은 그림 쌍을 선이 겹치지 않게 이어 길을 완성하는 클래식 두뇌 퍼즐입니다. 시간·생명 제한이 없어 출퇴근길이나 자기 전 차분하게 몰입하기 좋습니다.',
    badges: ['시간·생명 제한 없음', '되돌리기 지원', '자동 저장', '무료 플레이'],
    playUrl: 'https://play.google.com/store/apps/details?id=com.jrhapps.linktrail&hl=ko',
    iconUrl: 'https://jrh-apps-site.vercel.app/assets/link-trail-icon.webp',
    thumbUrl: 'https://jrh-apps-site.vercel.app/assets/link-trail-play-ko-thumb.webp',
  },
  {
    id: 'link-shift',
    name: 'Link Shift',
    enName: '사천성 타일 퍼즐',
    genre: '타일 매칭 퍼즐',
    tagline: '같은 타일, 이어지는 즐거움.',
    description:
      '번거로운 회원가입·로그인 없이 켜자마자 바로 즐기는 사천성 스타일 타일 퍼즐입니다. 매일 새롭게 열리는 데일리 퍼즐로 가볍게 두뇌 워밍업을 해 보세요.',
    badges: ['로그인 불필요', '매일 데일리 퍼즐', '빠른 한 판', '무료 플레이'],
    playUrl: 'https://play.google.com/store/apps/details?id=com.jrhapps.linkshift&hl=ko',
    extraUrl: { label: '24초 플레이 영상', href: 'https://www.youtube.com/shorts/fEVoKJ7UKBM' },
    iconUrl: 'https://jrh-apps-site.vercel.app/assets/link-shift-icon.webp',
    thumbUrl: 'https://jrh-apps-site.vercel.app/assets/link-shift-play-thumb.webp',
  },
];

const allPosts = await getPublishedPosts();
const appPosts = allPosts.filter((p) => p.data.category === 'apps');
---

<BaseLayout
  title="추천 앱 — 무료 오프라인 · 힐링 퍼즐 4선"
  description="로그인 없이, 시간 제한 없이 출퇴근길과 휴식 시간에 가볍게 즐길 수 있는 Google Play 무료 퍼즐 앱 4종(Cable Fix, 꽃담, Link Trail, Link Shift)을 소개합니다."
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10">
    <!-- Breadcrumb -->
    <nav class="mb-4 text-xs text-slate-500 dark:text-slate-400">
      <a href={withBase('/')} class="hover:text-blue-700">홈</a>
      <span class="mx-1.5">/</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium">추천 앱</span>
    </nav>

    <!-- Editorial Header -->
    <header class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4 pb-8 border-b-2 border-slate-900 dark:border-slate-700">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 px-3 py-1 text-xs font-bold text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900">
          Google Play 무료 출시작
        </span>
        <h1 class="mt-3 text-3xl sm:text-4xl font-black tracking-tight text-slate-950 dark:text-white">
          스펙노트 추천 무료 퍼즐 앱 4선
        </h1>
        <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300">
          복잡한 과금 유도나 시간 압박 없이, 일하다 잠시 머리 식힐 때나 출퇴근길에 가볍게 즐길 수 있는 무료 안드로이드 퍼즐 앱을 모았습니다.
        </p>
      </div>
      <a
        href="https://jrh-apps-site.vercel.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 self-start md:self-auto rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-2.5 text-xs font-bold text-slate-800 dark:text-slate-200 hover:border-blue-600 hover:text-blue-700 transition-colors"
      >
        전체 앱 포트폴리오 보기 ↗
      </a>
    </header>

    <!-- 4-App Showcase Grid -->
    <section class="grid gap-6 md:grid-cols-2">
      {APPS.map((app) => (
        <article class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs hover:shadow-md transition-shadow">
          <!-- Play Screenshot Banner -->
          <div class="relative aspect-[16/9] overflow-hidden bg-slate-950 border-b border-slate-100 dark:border-slate-800">
            <img
              src={app.thumbUrl}
              alt={`${app.name} 실제 플레이 화면`}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
            <span class="absolute top-3 left-3 rounded-full bg-slate-950/80 backdrop-blur-xs px-3 py-1 text-[11px] font-bold text-white">
              {app.genre}
            </span>
            <span class="absolute top-3 right-3 rounded-full bg-emerald-600 px-2.5 py-1 text-[11px] font-bold text-white">
              무료 · 출시됨
            </span>
          </div>

          <!-- App Info -->
          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
              <div class="flex items-center gap-3.5">
                <img
                  src={app.iconUrl}
                  alt={`${app.name} 아이콘`}
                  width="56"
                  height="56"
                  loading="lazy"
                  class="h-14 w-14 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xs shrink-0 object-cover"
                />
                <div>
                  <div class="flex items-baseline gap-2">
                    <h2 class="text-xl font-extrabold text-slate-950 dark:text-white tracking-tight">
                      {app.name}
                    </h2>
                    {app.enName && (
                      <span class="text-xs font-semibold text-slate-400">{app.enName}</span>
                    )}
                  </div>
                  <p class="mt-0.5 text-sm font-semibold text-blue-700 dark:text-blue-400">
                    “{app.tagline}”
                  </p>
                </div>
              </div>

              <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                {app.description}
              </p>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {app.badges.map((b) => (
                  <span class="rounded-md bg-slate-100 dark:bg-slate-800 px-2.5 py-1 text-[11px] font-semibold text-slate-700 dark:text-slate-300">
                    ✓ {b}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-6 flex flex-wrap items-center gap-2.5 pt-4 border-t border-slate-100 dark:border-slate-800">
              <a
                href={app.playUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-xl bg-blue-700 hover:bg-blue-800 px-4 py-2.5 text-sm font-bold text-white shadow-xs transition-colors"
              >
                <span>Google Play 무료 다운로드</span>
                <span aria-hidden="true">↗</span>
              </a>
              {app.extraUrl && (
                <a
                  href={app.extraUrl.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 px-3.5 py-2.5 text-xs font-bold text-slate-700 dark:text-slate-200 transition-colors"
                >
                  {app.extraUrl.label}
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </section>

    <!-- Related App Review Articles -->
    {appPosts.length > 0 && (
      <section class="mt-14 pt-10 border-t border-slate-200 dark:border-slate-800">
        <h2 class="text-xl font-extrabold text-slate-950 dark:text-white mb-6">
          추천 앱 상세 리뷰 리포트
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {appPosts.map((post) => (
            <PostCard post={post} variant="grid" />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
