---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES } from '../../config/site';
import { getPublishedPosts } from '../../utils/posts';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return CATEGORIES.map((cat) => ({
    params: { category: cat.slug },
    props: {
      category: cat,
      posts: posts.filter((p) => p.data.category === cat.slug),
    },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`${category.label} 가이드 모음`} description={category.description}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10">
    <nav class="mb-4 text-xs text-slate-500 dark:text-slate-400">
      <a href={withBase('/')} class="hover:text-blue-600">홈</a>
      <span class="mx-1.5">/</span>
      <span class="text-slate-800 dark:text-slate-200">{category.label}</span>
    </nav>

    <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        {category.label}
      </h1>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300 max-w-2xl">
        {category.description}
      </p>
    </header>

    {posts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="py-16 text-center text-slate-500">아직 등록된 글이 없습니다. 곧 최신 가이드가 업데이트됩니다.</p>
    )}
  </div>
</BaseLayout>
