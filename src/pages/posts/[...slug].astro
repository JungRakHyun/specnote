---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import MdxLink from '../../components/MdxLink.astro';
import { getPublishedPosts, getRelatedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const relatedPosts = getRelatedPosts(post, allPosts, 3);
---

<PostLayout post={post} headings={headings} relatedPosts={relatedPosts}>
  <Content components={{ a: MdxLink }} />
</PostLayout>
