---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, SITE } from '../config/site';
import { formatDateKo, getPublishedPosts } from '../utils/posts';
import { withBase } from '../utils/url';

const posts = await getPublishedPosts();
const leadPost = posts.find((p) => p.data.featured) ?? posts[0];
const sidePosts = posts.filter((p) => p.id !== leadPost?.id).slice(0, 4);

const categoryCounts = new Map<string, number>();
for (const p of posts) {
  categoryCounts.set(p.data.category, (categoryCounts.get(p.data.category) ?? 0) + 1);
}

const hotTags = Array.from(
  new Set(posts.flatMap((p) => p.data.tags))
).slice(0, 6);

const latestDate = posts[0]?.data.pubDate ?? new Date();
---

<BaseLayout>
  <!-- Compact Editorial Ticker Bar (0초 만에 미디어 정체성 + 인기 키워드 노출) -->
  <div class="border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 sm:px-6 py-2.5 text-xs">
      <div class="flex items-center gap-2 text-slate-600 dark:text-slate-400">
        <span class="inline-flex items-center gap-1.5 font-bold text-slate-900 dark:text-white">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          {SITE.tagline}
        </span>
        <span class="hidden sm:inline text-slate-300 dark:text-slate-700">|</span>
        <span class="hidden sm:inline text-slate-500">최근 업데이트 {formatDateKo(latestDate)}</span>
      </div>
      <div class="hidden md:flex items-center gap-1.5">
        <span class="text-slate-400 mr-1">인기 키워드</span>
        {hotTags.map((tag) => (
          <a
            href={withBase(`/tags/${encodeURIComponent(tag)}/`)}
            class="rounded-full border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 px-2.5 py-0.5 font-medium text-slate-600 dark:text-slate-300 hover:border-blue-600 hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Above-the-Fold 1면 Magazine Front Page (스크롤 없이 즉시 기사 노출!) -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-7 sm:pt-9">
    <div class="grid gap-7 lg:grid-cols-12 items-start">
      <!-- Left 7 cols: Lead Feature -->
      {leadPost && (
        <div class="lg:col-span-7">
          <div class="mb-3 flex items-center justify-between">
            <span class="text-xs font-extrabold uppercase tracking-wider text-blue-700 dark:text-blue-400">
              TODAY'S LEAD REPORT
            </span>
            <span class="text-xs text-slate-400">에디터 핵심 비교</span>
          </div>
          <PostCard post={leadPost} variant="lead" />
        </div>
      )}

      <!-- Right 5 cols: Editorial Briefing Rail -->
      <div class="lg:col-span-5">
        <div class="mb-3 flex items-center justify-between">
          <span class="text-xs font-extrabold uppercase tracking-wider text-slate-900 dark:text-white">
            주요 비교 · 최신 리포트
          </span>
          <span class="text-xs text-slate-400">총 {posts.length}편</span>
        </div>

        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 divide-y divide-slate-100 dark:divide-slate-800 shadow-xs">
          {sidePosts.map((post) => (
            <PostCard post={post} variant="compact" />
          ))}
        </div>

        <!-- Compact Quick Category Box -->
        <div class="mt-4 grid grid-cols-2 gap-2.5">
          {CATEGORIES.map((cat) => (
            <a
              href={withBase(`/category/${cat.slug}/`)}
              class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3.5 py-2.5 text-xs font-bold text-slate-800 dark:text-slate-200 hover:border-blue-600 hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
            >
              <span>{cat.label}</span>
              <span class="text-[11px] font-semibold text-slate-400">{categoryCounts.get(cat.slug) ?? 0}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Full Latest Reports Section -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-14">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3 pb-3 border-b-2 border-slate-900 dark:border-slate-700">
      <div>
        <h2 class="text-xl sm:text-2xl font-black tracking-tight text-slate-950 dark:text-white">
          전체 비교 리포트
        </h2>
        <p class="mt-1 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
          공식 요금표와 하드웨어 스펙을 기준으로 정리한 최신 가이드
        </p>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {CATEGORIES.map((cat) => (
          <a
            href={withBase(`/category/${cat.slug}/`)}
            class="rounded-full border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3 py-1 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:border-blue-600 hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
          >
            {cat.shortLabel}
          </a>
        ))}
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <PostCard post={post} variant="grid" />
      ))}
    </div>
  </section>

  <!-- E-E-A-T Editorial Standards Strip (신뢰도 & 애드센스 품질 신호 강화) -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-16">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="max-w-xl">
          <span class="text-xs font-extrabold uppercase tracking-wider text-blue-700 dark:text-blue-400">
            EDITORIAL STANDARDS
          </span>
          <h2 class="mt-1.5 text-lg sm:text-xl font-extrabold text-slate-950 dark:text-white">
            스펙노트는 과장된 광고 글 대신 숫자로 검증합니다
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            모든 AI 요금제·하드웨어 가이드는 제조사 공식 스펙과 최신 가격을 교차 확인해 작성하며, 제휴 링크가 포함된 글은 상단에 투명하게 고지합니다.
          </p>
        </div>
        <div class="flex flex-wrap gap-2.5 shrink-0">
          <a
            href={withBase('/about/')}
            class="inline-flex items-center rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 py-2.5 text-xs font-bold text-slate-800 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
          >
            편집 원칙 보기
          </a>
          <a
            href={withBase('/rss.xml')}
            class="inline-flex items-center rounded-xl bg-slate-950 dark:bg-blue-600 hover:bg-slate-800 dark:hover:bg-blue-500 px-4 py-2.5 text-xs font-bold text-white transition-colors"
          >
            RSS 구독하기
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
