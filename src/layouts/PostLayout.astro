---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PostCard from '../components/PostCard.astro';
import { getCategoryMeta, SITE } from '../config/site';
import { estimateReadingTime, formatDateKo, type PostEntry } from '../utils/posts';
import { absoluteUrl, withBase } from '../utils/url';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: PostEntry;
  headings: Heading[];
  relatedPosts: PostEntry[];
}

const { post, headings, relatedPosts } = Astro.props;
const { data } = post;
const cat = getCategoryMeta(data.category);
const catHref = data.category === 'apps' ? withBase('/apps/') : withBase(`/category/${cat.slug}/`);
const readMin = estimateReadingTime(post.body);
const coverSrc = data.cover ? withBase(data.cover) : withBase(SITE.ogDefaultImage);
const canonicalUrl = absoluteUrl(`/posts/${post.id}/`, Astro.site ?? SITE.url);
const ogImageAbs = absoluteUrl(data.cover ?? SITE.ogDefaultImage, Astro.site ?? SITE.url);

// SEO Structured Data: BlogPosting + BreadcrumbList + FAQPage (if present)
const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  image: [ogImageAbs],
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  inLanguage: 'ko-KR',
  author: {
    '@type': 'Person',
    name: data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: absoluteUrl('/', Astro.site ?? SITE.url),
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  keywords: data.tags.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '홈',
      item: absoluteUrl('/', Astro.site ?? SITE.url),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: cat.label,
      item: absoluteUrl(`/category/${cat.slug}/`, Astro.site ?? SITE.url),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: data.title,
      item: canonicalUrl,
    },
  ],
};

const jsonLdList: Record<string, unknown>[] = [blogPostingSchema, breadcrumbSchema];

if (data.faqs && data.faqs.length > 0) {
  jsonLdList.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}

const affiliateNotice =
  data.affiliateType === 'coupang'
    ? SITE.affiliate.coupangNotice
    : data.affiliateType === 'general'
      ? SITE.affiliate.generalNotice
      : null;
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.cover ?? SITE.ogDefaultImage}
  ogType="article"
  publishedTime={data.pubDate.toISOString()}
  modifiedTime={(data.updatedDate ?? data.pubDate).toISOString()}
  jsonLd={jsonLdList}
>
  <!-- Reading Progress Bar -->
  <div id="reading-progress" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-8 pb-12">
    <!-- Breadcrumbs -->
    <nav aria-label="브레드크럼" class="mb-6 flex flex-wrap items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
      <a href={withBase('/')} class="hover:text-blue-600 dark:hover:text-blue-400">홈</a>
      <span>/</span>
      <a href={catHref} class="hover:text-blue-600 dark:hover:text-blue-400">
        {cat.label}
      </a>
      <span>/</span>
      <span class="text-slate-700 dark:text-slate-300 truncate max-w-xs sm:max-w-md">{data.title}</span>
    </nav>

    <div class="grid gap-10 lg:grid-cols-[260px_minmax(0,1fr)] xl:grid-cols-[272px_minmax(0,1fr)] lg:items-start">
      <!-- Main Article Column (DOM 순서 우선 → 모바일/SEO 최적화, 데스크톱은 우측 배치) -->
      <article class="min-w-0 lg:order-2 max-w-[800px] w-full">
        <!-- Header -->
        <header class="mb-8">
          <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
            <a
              href={catHref}
              class="rounded-full bg-blue-50 dark:bg-blue-950/70 px-3 py-1 text-blue-700 dark:text-blue-300"
            >
              {cat.label}
            </a>
            <span class="text-slate-400">·</span>
            <time datetime={data.pubDate.toISOString()} class="text-slate-500 dark:text-slate-400 font-normal">
              {formatDateKo(data.pubDate)}
            </time>
            {data.updatedDate && (
              <>
                <span class="text-slate-400">·</span>
                <span class="text-emerald-600 dark:text-emerald-400 font-medium">
                  업데이트 {formatDateKo(data.updatedDate)}
                </span>
              </>
            )}
            <span class="text-slate-400">·</span>
            <span class="text-slate-500 dark:text-slate-400 font-normal">약 {readMin}분 읽기</span>
          </div>

          <h1 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
            {data.title}
          </h1>

          <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-300">
            {data.description}
          </p>
        </header>

        <!-- Cover Image -->
        <figure class="mb-8 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-900 shadow-sm">
          <img
            src={coverSrc}
            alt={data.coverAlt ?? data.title}
            loading="eager"
            decoding="async"
            class="aspect-[16/9] w-full object-cover"
          />
        </figure>

        <!-- FTC / 공정위 제휴 고지 (affiliateType이 none이 아닐 때 자동 표시) -->
        {affiliateNotice && (
          <div class="mb-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-100/80 dark:bg-slate-900/70 px-4 py-3 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            <span class="font-semibold text-slate-800 dark:text-slate-200">제휴 안내:</span> {affiliateNotice}
          </div>
        )}

        <!-- TL;DR 핵심 3줄 요약 카드 -->
        {data.tldr && data.tldr.length > 0 && (
          <section class="mb-8 rounded-2xl border border-blue-200/80 dark:border-blue-900/60 bg-gradient-to-br from-blue-50/80 to-indigo-50/50 dark:from-blue-950/40 dark:to-indigo-950/20 p-5 sm:p-6">
            <h2 class="text-sm font-extrabold tracking-tight text-blue-800 dark:text-blue-300 flex items-center gap-2">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-md bg-blue-600 text-[11px] font-bold text-white">✓</span>
              30초 핵심 요약
            </h2>
            <ul class="mt-3 space-y-2 text-sm leading-relaxed text-slate-700 dark:text-slate-200">
              {data.tldr.map((point) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-600 dark:bg-blue-400"></span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- 모바일 전용 접이식 목차 -->
        {headings.filter((h) => h.depth >= 2 && h.depth <= 3).length > 0 && (
          <details class="lg:hidden mb-8 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 px-5 py-3.5">
            <summary class="flex cursor-pointer items-center justify-between text-xs font-extrabold tracking-wider uppercase text-slate-900 dark:text-white list-none">
              <span>목차 바로가기</span>
              <span class="text-slate-400">▾</span>
            </summary>
            <ul class="mt-3 space-y-1.5 text-sm border-t border-slate-100 dark:border-slate-800 pt-3">
              {headings
                .filter((h) => h.depth >= 2 && h.depth <= 3)
                .map((h) => (
                  <li class:list={[h.depth === 3 ? 'pl-3' : '']}>
                    <a
                      href={`#${h.slug}`}
                      class="block py-1 text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
            </ul>
          </details>
        )}

        <!-- AdSense: Post Top -->
        <AdSlot position="postTop" />

        <!-- Article Body -->
        <div class="prose-tech">
          <slot />
        </div>

        <!-- AdSense: Post In-Article / Bottom -->
        <AdSlot position="postBottom" format="auto" />

        <!-- FAQ Accordion Section (구글 리치 스니펫 연동) -->
        {data.faqs && data.faqs.length > 0 && (
          <section class="mt-12 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 p-6">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
              자주 묻는 질문 (FAQ)
            </h2>
            <div class="divide-y divide-slate-200 dark:divide-slate-800">
              {data.faqs.map((faq) => (
                <details class="group py-3.5" open>
                  <summary class="flex cursor-pointer items-center justify-between gap-3 text-sm sm:text-base font-semibold text-slate-900 dark:text-white list-none">
                    <span>Q. {faq.question}</span>
                    <span class="text-slate-400 transition-transform group-open:rotate-180">▾</span>
                  </summary>
                  <p class="mt-2.5 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                    {faq.answer}
                  </p>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- Tags -->
        <div class="mt-8 flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <a
              href={withBase(`/tags/${encodeURIComponent(tag)}/`)}
              class="rounded-full border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3 py-1 text-xs font-medium text-slate-600 dark:text-slate-300 hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>

        <!-- Author Box (E-E-A-T 신뢰도 강화) -->
        <div class="mt-10 flex items-start gap-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 p-5">
          <svg class="h-11 w-11 shrink-0" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <rect width="64" height="64" rx="14" class="fill-slate-950 dark:fill-white"/>
            <rect x="14" y="16" width="22" height="6" rx="3" class="fill-white dark:fill-slate-950"/>
            <rect x="14" y="29" width="36" height="6" rx="3" fill="#2563EB"/>
            <rect x="14" y="42" width="28" height="6" rx="3" fill="#10B981"/>
            <circle cx="48" cy="19" r="4" fill="#38BDF8"/>
          </svg>
          <div>
            <div class="text-sm font-bold text-slate-900 dark:text-white">{data.author}</div>
            <p class="mt-1 text-xs sm:text-sm leading-relaxed text-slate-600 dark:text-slate-400">
              {SITE.author.bio}
            </p>
          </div>
        </div>
      </article>

      <!-- Sticky Left Sidebar (Desktop) -->
      <aside class="lg:order-1 lg:sticky lg:top-24 space-y-5">
        <div class="hidden lg:block">
          <TableOfContents headings={headings} />
        </div>
        <AdSlot position="sidebar" format="rectangle" />

        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs">
          <div class="text-[11px] font-extrabold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">FREE PUZZLE APPS</div>
          <h3 class="mt-1.5 text-sm font-extrabold text-slate-950 dark:text-white">잠깐 머리 식힐 무료 퍼즐 앱 4선</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            시간 제한·로그인 없이 오프라인에서도 가볍게 즐기는 Link Shift, 꽃담, Cable Fix, Link Trail을 만나보세요.
          </p>
          <a
            href={withBase('/apps/')}
            class="mt-3.5 inline-flex w-full items-center justify-center rounded-xl bg-emerald-600 hover:bg-emerald-700 px-3.5 py-2 text-xs font-bold text-white transition-colors"
          >
            추천 앱 보러가기 →
          </a>
        </div>

        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs">
          <div class="text-[11px] font-extrabold uppercase tracking-wider text-blue-700 dark:text-blue-400">TOPIC REQUEST</div>
          <h3 class="mt-1.5 text-sm font-extrabold text-slate-950 dark:text-white">비교해 주길 원하는 주제가 있나요?</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
            궁금한 AI 툴·요금제·IT 기기 스펙 비교 요청이나 정보 정정 제보를 편하게 보내주세요.
          </p>
          <a
            href={withBase('/contact/')}
            class="mt-3.5 inline-flex w-full items-center justify-center rounded-xl bg-slate-950 dark:bg-blue-600 hover:bg-slate-800 dark:hover:bg-blue-500 px-3.5 py-2 text-xs font-bold text-white transition-colors"
          >
            주제 제안 · 문의하기
          </a>
        </div>
      </aside>
    </div>

    <!-- Related Posts (체류 시간 & 페이지뷰 상승 핵심!) -->
    {relatedPosts.length > 0 && (
      <section class="mt-16 pt-10 border-t border-slate-200 dark:border-slate-800">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">
            함께 읽으면 좋은 글
          </h2>
          <a href={withBase('/')} class="text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline">
            전체 글 보기 →
          </a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedPosts.map((related) => (
            <PostCard post={related} />
          ))}
        </div>
      </section>
    )}
  </div>

  <!-- Reading Progress Bar Script -->
  <script is:inline>
    (() => {
      const bar = document.getElementById('reading-progress');
      if (!bar) return;
      const update = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
        bar.style.width = `${pct}%`;
      };
      window.addEventListener('scroll', update, { passive: true });
      update();
    })();
  </script>
</BaseLayout>
