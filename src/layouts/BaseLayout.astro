---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import { SITE } from '../config/site';
import { absoluteUrl, withBase } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogDefaultImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.koName} (${SITE.name})` : `${SITE.koName} (${SITE.name}) — ${SITE.tagline}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const ogImageURL = absoluteUrl(image, Astro.site ?? SITE.url);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${SITE.koName} (${SITE.name})`,
  url: absoluteUrl('/', Astro.site ?? SITE.url),
  description: SITE.description,
  inLanguage: 'ko-KR',
};

const schemas = Array.isArray(jsonLd)
  ? [websiteSchema, ...jsonLd]
  : jsonLd
    ? [websiteSchema, jsonLd]
    : [websiteSchema];
---

<!doctype html>
<html lang={SITE.lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F172A" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={SITE.koName} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.koName} RSS`} href={withBase('/rss.xml')} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author.name} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Search Engine Verification (구글/네이버/빙) -->
    {SITE.verification.google && <meta name="google-site-verification" content={SITE.verification.google} />}
    {SITE.verification.naver && <meta name="naver-site-verification" content={SITE.verification.naver} />}
    {SITE.verification.bing && <meta name="msvalidate.01" content={SITE.verification.bing} />}

    <!-- Open Graph / Naver / KakaoTalk / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={`${SITE.koName} (${SITE.name})`} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Pretendard Korean Editorial Font -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />

    <!-- Light-First Editorial Theme (사용자가 다크 모드를 직접 선택한 경우에만 적용) -->
    <script is:inline>
      (() => {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Google AdSense (clientId 설정 시 자동 활성화) -->
    {SITE.adsense.clientId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsense.clientId}`}
        crossorigin="anonymous"
      />
    )}

    <!-- Google Analytics 4 -->
    {SITE.ga4MeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4MeasurementId}`} />
        <script is:inline define:vars={{ gaId: SITE.ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- JSON-LD Structured Data -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>

  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchModal />

    <!-- Theme Toggle Handler -->
    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle-btn');
        btn?.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      })();
    </script>

    <!-- iOS Safari 홈 화면 추가 안내 토스트 -->
    <div
      id="ios-install-toast"
      role="dialog"
      aria-label="아이폰 앱 설치 안내"
      class="fixed bottom-4 left-1/2 z-50 hidden w-[calc(100%-2rem)] max-w-sm -translate-x-1/2 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-4 shadow-xl"
    >
      <div class="flex items-start justify-between gap-3">
        <div>
          <div class="text-xs font-extrabold text-blue-700 dark:text-blue-400">iPhone / iPad 앱 설치</div>
          <p class="mt-1 text-xs leading-relaxed text-slate-600 dark:text-slate-300">
            Safari 하단 <strong>공유 버튼(□↑)</strong>을 누른 뒤 <strong>‘홈 화면에 추가’</strong>를 선택하면 앱처럼 바로 실행할 수 있습니다.
          </p>
        </div>
        <button
          type="button"
          id="ios-install-close"
          aria-label="닫기"
          class="rounded-lg px-2 py-1 text-xs font-bold text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-700 dark:hover:text-slate-200 cursor-pointer"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- PWA Service Worker & Install Prompt Handler -->
    <script is:inline define:vars={{ swUrl: withBase('/sw.js'), swScope: withBase('/') }}>
      (() => {
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register(swUrl, { scope: swScope }).catch(() => {});
          });
        }

        const installBtn = document.getElementById('pwa-install-btn');
        const iosToast = document.getElementById('ios-install-toast');
        const iosClose = document.getElementById('ios-install-close');
        if (!installBtn) return;

        const isStandalone =
          window.matchMedia('(display-mode: standalone)').matches ||
          window.navigator.standalone === true;
        if (isStandalone) return;

        let deferredPrompt = null;
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;

        if (isIOS) {
          installBtn.classList.remove('hidden');
          installBtn.classList.add('inline-flex');
        }

        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          deferredPrompt = e;
          installBtn.classList.remove('hidden');
          installBtn.classList.add('inline-flex');
        });

        installBtn.addEventListener('click', async () => {
          if (deferredPrompt) {
            deferredPrompt.prompt();
            const { outcome } = await deferredPrompt.userChoice;
            if (outcome === 'accepted') {
              installBtn.classList.add('hidden');
              installBtn.classList.remove('inline-flex');
            }
            deferredPrompt = null;
          } else if (isIOS && iosToast) {
            iosToast.classList.remove('hidden');
          }
        });

        iosClose?.addEventListener('click', () => {
          iosToast?.classList.add('hidden');
        });

        window.addEventListener('appinstalled', () => {
          deferredPrompt = null;
          installBtn.classList.add('hidden');
          installBtn.classList.remove('inline-flex');
        });
      })();
    </script>
  </body>
</html>
