---
import { getCategoryMeta, SITE } from '../config/site';
import { estimateReadingTime, formatDateKo, type PostEntry } from '../utils/posts';
import { withBase } from '../utils/url';

interface Props {
  post: PostEntry;
  variant?: 'lead' | 'compact' | 'grid';
  featured?: boolean;
}

const { post, variant, featured = false } = Astro.props;
const mode = variant ?? (featured ? 'lead' : 'grid');
const cat = getCategoryMeta(post.data.category);
const catHref = post.data.category === 'apps' ? withBase('/apps/') : withBase(`/category/${cat.slug}/`);
const readMin = estimateReadingTime(post.body);
const postUrl = withBase(`/posts/${post.id}/`);
const coverSrc = post.data.cover ? withBase(post.data.cover) : withBase(SITE.ogDefaultImage);
---

{mode === 'lead' && (
  <article class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs hover:shadow-md transition-all">
    <a href={postUrl} class="relative block aspect-[16/9] overflow-hidden bg-slate-950">
      <img
        src={coverSrc}
        alt={post.data.coverAlt ?? post.data.title}
        loading="eager"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      />
    </a>

    <div class="flex flex-1 flex-col justify-between p-6 sm:p-7">
      <div>
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <a
            href={catHref}
            class="font-bold text-blue-700 dark:text-blue-400 hover:underline"
          >
            {cat.label}
          </a>
          <span class="text-slate-300 dark:text-slate-700">|</span>
          <time datetime={post.data.pubDate.toISOString()} class="text-slate-500 dark:text-slate-400">
            {formatDateKo(post.data.pubDate)}
          </time>
          <span class="text-slate-300 dark:text-slate-700">·</span>
          <span class="text-slate-500 dark:text-slate-400">약 {readMin}분 읽기</span>
        </div>

        <h1 class="mt-3 text-2xl sm:text-[1.75rem] font-extrabold tracking-tight text-slate-950 dark:text-white leading-snug group-hover:text-blue-700 dark:group-hover:text-blue-400 transition-colors">
          <a href={postUrl}>{post.data.title}</a>
        </h1>

        <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300">
          {post.data.description}
        </p>

        {post.data.tldr && post.data.tldr.length > 0 && (
          <ul class="mt-4 space-y-1.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 p-3.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300 border border-slate-100 dark:border-slate-800">
            {post.data.tldr.slice(0, 2).map((point) => (
              <li class="flex items-start gap-2 leading-relaxed">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-600 dark:bg-blue-400"></span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="mt-5 flex items-center justify-between pt-4 border-t border-slate-100 dark:border-slate-800">
        <div class="flex flex-wrap gap-1.5">
          {post.data.tags.slice(0, 3).map((tag) => (
            <span class="rounded-md bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-[11px] font-medium text-slate-600 dark:text-slate-400">
              #{tag}
            </span>
          ))}
        </div>
        <a
          href={postUrl}
          class="text-xs sm:text-sm font-bold text-blue-700 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform"
        >
          리포트 읽기 →
        </a>
      </div>
    </div>
  </article>
)}

{mode === 'compact' && (
  <article class="group flex items-start gap-4 py-4 first:pt-0 last:pb-0">
    <a
      href={postUrl}
      class="relative block w-32 sm:w-36 aspect-[16/10] shrink-0 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-950"
    >
      <img
        src={coverSrc}
        alt={post.data.coverAlt ?? post.data.title}
        loading="eager"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    </a>

    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-1.5 text-[11px]">
        <a
          href={withBase(`/category/${cat.slug}/`)}
          class="font-bold text-blue-700 dark:text-blue-400 hover:underline"
        >
          {cat.label}
        </a>
        <span class="text-slate-300 dark:text-slate-700">·</span>
        <span class="text-slate-500 dark:text-slate-400">{readMin}분</span>
      </div>
      <h2 class="mt-1 text-sm sm:text-[0.98rem] font-bold tracking-tight text-slate-950 dark:text-white leading-snug line-clamp-2 group-hover:text-blue-700 dark:group-hover:text-blue-400 transition-colors">
        <a href={postUrl}>{post.data.title}</a>
      </h2>
      <p class="mt-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400 line-clamp-2">
        {post.data.description}
      </p>
    </div>
  </article>
)}

{mode === 'grid' && (
  <article class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-slate-300 dark:hover:border-slate-700 hover:shadow-md transition-all">
    <a href={postUrl} class="relative block aspect-[16/9] overflow-hidden bg-slate-950">
      <img
        src={coverSrc}
        alt={post.data.coverAlt ?? post.data.title}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      />
    </a>

    <div class="flex flex-1 flex-col justify-between p-5">
      <div>
        <div class="flex items-center gap-2 text-xs">
          <a
            href={catHref}
            class="font-bold text-blue-700 dark:text-blue-400 hover:underline"
          >
            {cat.label}
          </a>
          <span class="text-slate-300 dark:text-slate-700">·</span>
          <span class="text-slate-500 dark:text-slate-400">{readMin}분 읽기</span>
        </div>

        <h3 class="mt-2.5 text-lg font-bold tracking-tight text-slate-950 dark:text-white leading-snug line-clamp-2 group-hover:text-blue-700 dark:group-hover:text-blue-400 transition-colors">
          <a href={postUrl}>{post.data.title}</a>
        </h3>

        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400 line-clamp-2">
          {post.data.description}
        </p>
      </div>

      <div class="mt-4 flex items-center justify-between pt-3 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDateKo(post.data.pubDate)}
        </time>
        <div class="flex gap-1.5">
          {post.data.tags.slice(0, 2).map((tag) => (
            <span class="text-[11px] text-slate-400 dark:text-slate-500">#{tag}</span>
          ))}
        </div>
      </div>
    </div>
  </article>
)}
