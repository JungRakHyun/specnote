---
/**
 * Wirecutter 스타일 제휴 추천 카드 (쿠팡 파트너스 / AI SaaS 공식 링크)
 */
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  priceNote?: string;
  highlights?: string[];
  ctaText?: string;
  href: string;
  provider?: 'coupang' | 'official' | 'affiliate';
}

const {
  title,
  subtitle,
  badge = '스펙노트 추천',
  priceNote,
  highlights = [],
  ctaText = '실시간 가격 · 공식 정보 확인',
  href,
  provider = 'official',
} = Astro.props;

const providerLabel =
  provider === 'coupang'
    ? '쿠팡 파트너스 제휴'
    : provider === 'affiliate'
      ? '공식 제휴 링크'
      : '공식 사이트';
---

<div class="not-prose my-7 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 border-t-2 border-t-blue-700 dark:border-t-blue-500 bg-white dark:bg-slate-900 p-5 sm:p-6 shadow-xs">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded-md bg-blue-700 px-2 py-0.5 text-[11px] font-bold text-white">
          {badge}
        </span>
        <span class="text-xs font-medium text-slate-400 dark:text-slate-500">{providerLabel}</span>
      </div>
      <h4 class="pt-0.5 text-lg font-extrabold text-slate-950 dark:text-white tracking-tight">
        {title}
      </h4>
      {subtitle && (
        <p class="text-sm text-slate-600 dark:text-slate-400">{subtitle}</p>
      )}
    </div>
    {priceNote && (
      <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 px-3.5 py-2 text-right">
        <div class="text-[11px] font-medium text-slate-500 dark:text-slate-400">참고 가격대</div>
        <div class="text-sm font-extrabold text-slate-950 dark:text-white">{priceNote}</div>
      </div>
    )}
  </div>

  {highlights.length > 0 && (
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {highlights.map((item) => (
        <li class="flex items-start gap-2 text-sm text-slate-700 dark:text-slate-300">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  )}

  <div class="mt-5 flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
    <p class="text-xs text-slate-500 dark:text-slate-400">
      가격과 할인 조건은 시점에 따라 변동될 수 있습니다.
    </p>
    <a
      href={href}
      target="_blank"
      rel={provider === 'official' ? 'noopener noreferrer' : 'nofollow sponsored noopener noreferrer'}
      class="inline-flex items-center gap-1.5 rounded-xl bg-blue-700 hover:bg-blue-800 px-4 py-2.5 text-sm font-bold text-white shadow-xs transition-colors"
    >
      <span>{ctaText}</span>
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>
</div>
